#!/usr/bin/expect -f
set timeout 30
log_user 1

spawn ./sms.exe

# 1. Load from file
expect "Enter your choice:"
send "2\r"
expect "Enter course's ID:"
send "1\r"
expect "add another course"
send "n\r"
expect "GPA manually:"
send "3.5\r"
expect "GPA manually:"
send "3.0\r"
expect "Press Enter"
send "\r"

# 2. Add student manually
expect "Enter your choice:"
send "1\r"
expect "Enter the roll number:"
send "2001\r"
expect "Enter the first name"
send "John\r"
expect "Enter the last name"
send "Doe\r"
expect "GPA:"
send "3.5\r"
expect "Enter course"
send "1\r"
expect "add another course"
send "n\r"
expect "Press Enter"
send "\r"

# 3. Search by roll
expect "Enter your choice:"
send "4\r"
expect "Enter the roll number:"
send "1001\r"
expect "Press Enter"
send "\r"

# 4. Search by first name
expect "Enter your choice:"
send "5\r"
expect "Name:"
send "Adel\r"
expect "Press Enter"
send "\r"

# 5. Search by course
expect "Enter your choice:"
send "6\r"
expect "course ID"
send "1\r"
expect "Press Enter"
send "\r"

# 6. Update student
expect "Enter your choice:"
send "8\r"
expect "to be updated:"
send "1001\r"
expect "Enter your choice:"
send "2\r"
expect "new first name"
send "AdelUpdated\r"
expect "another update"
send "n\r"
expect "Press Enter"
send "\r"

# 7. Delete student
expect "Enter your choice:"
send "7\r"
expect "to be deleted:"
send "1001\r"
expect "Press Enter"
send "\r"

# 8. Show stats
expect "Enter your choice:"
send "3\r"
expect "Press Enter"
send "\r"

# 9. Add student with invalid GPA
expect "Enter your choice:"
send "1\r"
expect "Enter the roll number:"
send "2002\r"
expect "Enter the first name"
send "Test\r"
expect "Enter the last name"
send "User\r"
expect "GPA:"
send "5.0\r"
expect "GPA:"
send "3.0\r"
expect "Enter course"
send "1\r"
expect "add another course"
send "n\r"
expect "Press Enter"
send "\r"

# 10. Exit
expect "Enter your choice:"
send "9\r"

expect eof
