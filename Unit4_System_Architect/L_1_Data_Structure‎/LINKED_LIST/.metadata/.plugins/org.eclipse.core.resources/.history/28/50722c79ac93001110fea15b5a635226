#ifndef LINKED_LIST_H_
#define LINKED_LIST_H_

#include <stdio.h>
#include "LINKED_LIST_cfg.h"

typedef struct{
	Element_DataType NodeData;
	NODE_t *NodeNext;
}NODE_t;


typedef enum {
	succeeded,
	failed
}LIST_Status_t;

//Primary Functions ↓↓↓

// Insert new Item in the list
LIST_Status_t LIST_Insert(NODE_t const **List, Element_DataType Item){
	LIST_Status_t returnFlag = succeeded;
	NODE_t *LastNode = NULL;
	NODE_t *TempNode = NULL; //Node to be inserted
	TempNode = (Element_DataType *)calloc(1, sizeof(NODE_t));

	// Checking if the calloc function has worked properly
	if( NULL != TempNode ){
		if( NULL == *List )
			*List = TempNode;
		else{
			LastNode = *List;
			TempNode->NodeData = Item;

			//Getting the last valid node
			while( NULL != LastNode->NodeNext )
				LastNode = LastNode->NodeNext;

			LastNode->NodeNext = TempNode;
		}
	}
	else
		returnFlag = failed;

	return returnFlag;
}

// Deleting a certain element
LIST_Status_t LIST_CDelete(NODE_t const **List, short ItemIndex){
	LIST_Status_t returnFlag = succeeded;
	NODE_t *LastNode     = NULL;
	NODE_t *TempNode     = NULL; //Node to be deleted
	unsigned int counter = 0;
	//Checking if the list element is not empty
	if( NULL != *List ){
		LastNode = *List;
		for( counter = 0 ; counter < ItemIndex ; counter++ )
			LastNode = LastNode->NodeNext;

		TempNode = LastNode->NodeNext;
		LastNode->NodeNext = LastNode->NodeNext->NodeNext;
		free(TempNode);
	}
	else
		returnFlag = failed;

	return returnFlag;
}

//

#endif /* LINKED_LIST_H_ */
