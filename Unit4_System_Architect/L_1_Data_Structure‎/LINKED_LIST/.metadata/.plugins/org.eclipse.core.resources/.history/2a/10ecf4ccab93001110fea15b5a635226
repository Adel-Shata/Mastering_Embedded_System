#ifndef LINKED_LIST_H_
#define LINKED_LIST_H_

#include <stdio.h>
#include "LINKED_LIST_cfg.h"

typedef struct{
	Element_DataType NodeData;
	NODE_t *NodeNext;
}NODE_t;

typedef enum {
	succeeded,
	failed,
	empty,
	full,
	neither_full_nor_empty
}LIST_Status_t;

// Insert new Item in the list
LIST_Status_t LIST_Insert(NODE_t const **List, Element_DataType Item){
	LIST_Status_t returnFlag = succeeded;
	NODE_t *LastNode = NULL;

	//Checking if the list is empty
	if( NULL == *List ){

		// Checking if the calloc function has worked properly
		if( NULL != ( *List = (Element_DataType *)calloc(1, sizeof(NODE_t)) ) ){
			(*List)->NodeData = Item;
			(*List)->NodeNext = (Element_DataType *)(NULL);
		}
		else
			returnFlag = failed;
	}
	else{
		LastNode = *List;
		//Getting the last valid node in the list
		while ( NULL != (LastNode->NodeNext) ){
			LastNode = LastNode->NodeNext;
		}
		// Checking if the calloc function has worked properly
		if ( NULL != ( LastNode->NodeNext = (Element_DataType *)calloc(1, sizeof(NODE_t)) ) ){
			LastNode->NodeNext->NodeData = Item;
			LastNode->NodeNext->NodeNext = (Element_DataType *)(NULL);
		}
		else
			returnFlag = failed;
	}

	return returnFlag;
}

//

#endif /* LINKED_LIST_H_ */
