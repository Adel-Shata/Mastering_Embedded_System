#include <stdio.h>
#include <stdlib.h>
#include "LINKED_LIST.h"

#define print(...) 	printf(__VA_ARGS__);\
					fflush(stdin);\
					fflush(stdout);


	void PrintList(struct NODE const *List)
	{
	    struct NODE const *TempNode = List;

	    print("List: ")

	    while (NULL != TempNode)
	    {
	        print("%d", TempNode->NodeData)

	        if (NULL != TempNode->NodeNext){
	        	print(" -> ")
	        }

	        TempNode = TempNode->NodeNext;
	    }

	    print("\n")
	}

	int main(void)
	{
	    struct NODE *List = NULL;

	    /* Insert 5 elements */
	    LIST_Insert((struct NODE const **)&List, 10);
	    LIST_Insert((struct NODE const **)&List, 20);
	    LIST_Insert((struct NODE const **)&List, 30);
	    LIST_Insert((struct NODE const **)&List, 40);
	    LIST_Insert((struct NODE const **)&List, 50);

	    PrintList(List);

	    /* Delete first element */
	    print("\nDeleting first element...\n");

	    LIST_CDelete((struct NODE const **)&List, 0);

	    PrintList(List);

	    /* Delete last element */
	    print("\nDeleting last element...\n");

	    LIST_CDelete((struct NODE const **)&List, 3);

	    PrintList(List);

	    /* Delete middle element */
	    print("\nDeleting middle element...\n");

	    LIST_CDelete((struct NODE const **)&List, 1);

	    PrintList(List);

	    return EXIT_SUCCESS;
	}
