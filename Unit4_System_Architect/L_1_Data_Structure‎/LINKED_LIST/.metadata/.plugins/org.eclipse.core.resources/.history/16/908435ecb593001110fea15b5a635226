#include <stdio.h>
#include <stdlib.h>
#include "LINKED_LIST.h"

#define print(...) 	printf(__VA_ARGS__);\
					fflush(stdin);\
					fflush(stdout);

int main(void) {
#include <stdio.h>
#include <stdlib.h>
#include "LINKED_LIST_cfg.h"

void PrintList(NODE_t const *List)
{
    NODE_t const *TempNode = List;

    print("List: ");

    while (NULL != TempNode)
    {
        print("%d", TempNode->NodeData);

        if (NULL != TempNode->NodeNext)
            print(" -> ");

        TempNode = TempNode->NodeNext;
    }

    print("\n");
}

int main(void)
{
    NODE_t *List = NULL;

    /* Insert 5 elements */
    print("Adding elements...\n");

    LIST_Insert((NODE_t const **)&List, 10);
    LIST_Insert((NODE_t const **)&List, 20);
    LIST_Insert((NODE_t const **)&List, 30);
    LIST_Insert((NODE_t const **)&List, 40);
    LIST_Insert((NODE_t const **)&List, 50);

    PrintList(List);

    /* Delete first element */
    print("\nDeleting first element...\n");

    LIST_CDelete((NODE_t const **)&List, 0);

    PrintList(List);

    /* Delete last element */
    print("\nDeleting last element...\n");

    LIST_CDelete((NODE_t const **)&List, 3);

    PrintList(List);

    /* Delete middle element */
    print("\nDeleting middle element...\n");

    LIST_CDelete((NODE_t const **)&List, 1);

    PrintList(List);

    return 0;
}
	return EXIT_SUCCESS;
}
