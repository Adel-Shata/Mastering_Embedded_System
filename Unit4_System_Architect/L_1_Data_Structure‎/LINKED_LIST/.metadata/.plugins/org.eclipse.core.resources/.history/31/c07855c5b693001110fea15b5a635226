#include <stdio.h>
#include <stdlib.h>
#include "LINKED_LIST_cfg.h"
#include "LINKED_LIST.h"

//Helper Functions ↓↓↓

static unsigned int LIST_Length(struct NODE *List){
    unsigned int NodeCount = 0;

    while(List != NULL){
        NodeCount++;
        List = List->NodeNext;
    }

    return NodeCount;
}

//Primary Functions ↓↓↓

// Insert new Item in the list
LIST_Status_t LIST_Insert(struct NODE const **List, Element_DataType Item){
	LIST_Status_t returnFlag = succeeded;
	struct NODE *LastNode = NULL;
	struct NODE *TempNode = NULL; //Node to be inserted
	TempNode = (struct NODE *)calloc(1, sizeof(struct NODE));

	// Checking if the calloc function has worked properly
	if( NULL != TempNode ){
		if( NULL == *List )
			*List = TempNode;
		else{
			LastNode = *List;
			TempNode->NodeData = Item;

			//Getting the last valid node
			while( NULL != LastNode->NodeNext )
				LastNode = LastNode->NodeNext;

			LastNode->NodeNext = TempNode;
		}
	}
	else
		returnFlag = failed;

	return returnFlag;
}

// Deleting a certain element
LIST_Status_t LIST_CDelete(struct NODE const **List, int ItemIndex){
	LIST_Status_t returnFlag = succeeded;
	struct NODE *LastNode     = NULL;
	struct NODE *TempNode     = NULL; //Node to be deleted
	unsigned int counter= 0;
	unsigned int ListLength = LIST_Length((struct NODE *)*List);

	//Checking if the list element is not empty, and the Index is valid
	if( (NULL != *List) && (ListLength > ItemIndex) && (ItemIndex >= 0) ){
		LastNode = *List;

		//ٌReaching the previous Item of the desired one
		for( counter = 0 ; counter < (ItemIndex - 1) ; counter++ )
			LastNode = LastNode->NodeNext;

		if (0 == ItemIndex){
			*List = (*List)->NodeNext;
			free(LastNode);
			LastNode = NULL;
		}
		else{
			TempNode = LastNode->NodeNext;
			LastNode->NodeNext = LastNode->NodeNext->NodeNext;
			free(TempNode);
			TempNode = NULL;
		}
	}
	else
		returnFlag = failed;

	return returnFlag;
}
